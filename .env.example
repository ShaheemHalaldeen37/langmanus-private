# LLM Environment variables

# Reasoning LLM (for complex reasoning tasks)
REASONING_API_KEY=gsk_xxx
REASONING_BASE_URL=https://api.groq.com/openai/v1
REASONING_MODEL=qwen/qwen3-32b

# Non-reasoning LLM (for straightforward tasks)
BASIC_API_KEY=gsk_xxx
BASIC_BASE_URL=https://api.groq.com/openai/v1
BASIC_MODEL=qwen/qwen3-32b

# Vision-language LLM (for the browser agent — must be vision-capable with a
# large context window; browser-use prompts exceed 8k tokens)
VL_API_KEY=gsk_xxx
VL_BASE_URL=https://api.groq.com/openai/v1
VL_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Application Settings
DEBUG=True
APP_ENV=development

# Add other environment variables as needed
TAVILY_API_KEY=tvly-xxx
# CHROME_INSTANCE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
